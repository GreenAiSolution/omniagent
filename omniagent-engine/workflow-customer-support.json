            {
              "name": "summary",
              "description": "One-paragraph summary of the issue and what the customer wants",
              "type": "string"
            },
            {
              "name": "customer",
              "description": "The customer's WhatsApp number",
              "type": "string"
            },
            {
              "name": "category",
              "description": "e.g. billing, order, returns, technical, complaint, other",
              "type": "string"
            },
            {
              "name": "priority",
              "description": "low | normal | high | urgent",
              "type": "string"
            }
          ]
        }
      },
